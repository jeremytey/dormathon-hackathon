!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python virtual environments
.venv/
venv/
env/

# Jupyter Notebook
.ipynb_checkpoints/

# Local databases
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# Temporary files
*.tmp
*.swp
*~

# macOS
.AppleDouble
.LSOverride

# Python build artifacts
build/
dist/
*.whl

# Environment variable files
.env
.env.*
!.env.example
# Streamlit secrets (API keys)
.streamlit/secrets.toml

